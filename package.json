{
	"name": "lilies",
	"version": "1.0.0",
	"license": "MIT",
	"private": false,
	"main": "dist/LinkedList.js",
	"type": "module",
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/me-andre/lilies.git"
	},
	"homepage": "https://github.com/me-andre/lilies#readme",
	"bugs": {
		"url": "https://github.com/me-andre/lilies/issues"
	},
	"keywords": [
		"linked-list",
		"doubly-linked-list",
		"data-structure",
		"list",
		"queue",
		"deque",
		"double-ended-queue",
		"collection",
		"esm",
		"iterator"
	],
	"scripts": {
		"test": "vitest run",
		"build": "if [ -d dist ]; then rm -rf dist; fi && tsc --outDir dist",
		"prepack": "npm run build",
		"lint": "biome check && tsc --noEmit",
		"lint:fix": "biome check --write --unsafe && tsc --noEmit",
		"perf": "if [ -d perf/dist ]; then rm -rf perf/dist; fi && tsc --outDir perf/dist && node perf/fixImports.js && node perf/list.js",
		"perf:visitor": "if [ -d perf/dist ]; then rm -rf perf/dist; fi && tsc --outDir perf/dist && node perf/fixImports.js && node perf/visitor.js"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@types/lodash": "^4.17.7",
		"benchmark": "^2.1.4",
		"lodash": "^4.17.21",
		"microtime": "^3.1.1",
		"typescript": "^5.5.4",
		"vitest": "^3.2.4"
	}
}
